# Alamat publik situs setelah di-deploy.
#
# Dipakai untuk metadata Open Graph / Twitter — yaitu gambar dan judul yang
# muncul saat link portfolio dibagikan (WhatsApp, LinkedIn, X, dsb).
#
# Selama masih lokal / belum deploy, variabel ini boleh dibiarkan kosong;
# aplikasi memakai nilai bawaan dan situs tetap berjalan normal.
#
# Setelah deploy, isi dengan domain aslinya, contoh:
#   NEXT_PUBLIC_SITE_URL=https://kakros.id
#
# Nilai bawaannya sudah https://kakros.id, jadi variabel ini hanya perlu diisi
# kalau domainnya berubah, atau kalau ingin URL Open Graph menunjuk ke URL
# pratinjau vercel.app saat menguji.
#
# Di Vercel: Project Settings > Environment Variables (jangan simpan di file ini).
NEXT_PUBLIC_SITE_URL=
